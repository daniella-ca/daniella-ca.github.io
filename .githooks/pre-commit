#!/usr/bin/env bash
# Encrypt plaintext pages from public-encrypted/_src/ into public-encrypted/
# before the commit is created, and refuse to let plaintext or the master
# secret reach this PUBLIC repository.
set -euo pipefail
export LC_ALL=C

# Hooks run non-interactively, so ~/.zshrc is never sourced and ~/.local/bin
# (where node lives on this machine) would otherwise be missing from PATH.
export PATH="$HOME/.local/bin:$PATH"

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

SRC="public-encrypted/_src"
OUT="public-encrypted"
MANIFEST=".encrypted-manifest"
KEYMAP=".page-keys"

# ---------------------------------------------------------------- guard 1
# Block plaintext / secrets even if forced past .gitignore with `git add -f`.
staged="$(git diff --cached --name-only)"
if blocked="$(printf '%s\n' "$staged" \
      | grep -E '^(public-encrypted/_src/|\.env$|\.env\.|\.staticrypt\.json$|\.page-keys$)')"; then
  echo "COMMIT BLOCKED - these must never enter a public repo:" >&2
  printf '  %s\n' $blocked >&2
  echo "Unstage with: git restore --staged <path>" >&2
  exit 1
fi

# ---------------------------------------------------------------- reminder
# "Client-identifying" cannot be detected reliably, so this warns, not blocks.
# It must run BEFORE the early exit below, or it never fires when _src/ is empty.
if outside="$(printf '%s\n' "$staged" | grep -E '\.html$' | grep -v '^public-encrypted/')"; then
  echo "NOTE - unencrypted HTML staged outside public-encrypted/:" >&2
  printf '  %s\n' $outside >&2
  echo "Confirm none contains client names, spend figures or account IDs." >&2
fi

# Nothing to encrypt is a valid state - let the commit through.
[ -d "$SRC" ] || exit 0
shopt -s nullglob
sources=("$SRC"/*.html)
if [ ${#sources[@]} -eq 0 ]; then exit 0; fi

# ---------------------------------------------------------------- guard 2
if [ ! -f .env ]; then
  echo "COMMIT BLOCKED - $SRC has pages but .env (master secret) is missing." >&2
  echo "Without it these pages cannot be encrypted, and committing them" >&2
  echo "unencrypted would publish them. Restore .env and retry." >&2
  exit 1
fi
set -a; . ./.env; set +a
: "${STATICRYPT_PASSWORD:?STATICRYPT_PASSWORD missing from .env}"
: "${STATICRYPT_SALT:?STATICRYPT_SALT missing from .env}"

# ENCRYPT_SECRET is only required if a page maps to a client slug (the derived
# scheme). Pages on MASTER or a legacy CLIENT_*_PW variable do not need it, so
# it is checked per page rather than up front.

# Resolve a .page-keys value to the password for that page.
#   MASTER          -> the master secret, internal pages only
#   CLIENT_<X>_PW   -> legacy stored password, still honoured
#   <client-slug>   -> derived from ENCRYPT_SECRET, nothing stored
resolve_password() {
  case "$1" in
    MASTER)        printf '%s' "$STATICRYPT_PASSWORD" ;;
    CLIENT_*_PW)   printf '%s' "${!1}" ;;
    *)             ENCRYPT_SECRET="$ENCRYPT_SECRET" python3 bin/derive_passphrase.py "$1" ;;
  esac
}

# staticrypt reads the salt from .staticrypt.json, and `--decrypt` REQUIRES
# that file to exist - without it the encrypted pages cannot be recovered from
# the command line. Regenerate it from .env so the salt stays fixed (stable
# output) and the recovery path always works. It holds only the salt, no
# password hash, but stays gitignored regardless.
printf '{"salt":"%s"}\n' "$STATICRYPT_SALT" > .staticrypt.json

touch "$MANIFEST" "$KEYMAP"

# ---------------------------------------------------------------- pass 1
# Resolve and validate EVERY page before encrypting ANY of them, so a missing
# mapping aborts with no half-finished work staged behind it.
todo_src=(); todo_base=(); todo_var=(); todo_hash=(); todo_pw=()

for src in "${sources[@]}"; do
  base="$(basename "$src")"
  var="$(awk -v f="$base" '$1==f {print $2; exit}' "$KEYMAP")"

  # Fail closed. A client page must NEVER silently inherit the master password:
  # that would hand every client the key to every other client's report.
  if [ -z "$var" ]; then
    echo "COMMIT BLOCKED - no password mapping for '$base'." >&2
    echo "" >&2
    echo "  Client-facing pages must have their own password. There is" >&2
    echo "  deliberately no fallback to the master password." >&2
    echo "" >&2
    echo "  For a client page, map it to their slug:" >&2
    echo "    bin/new-client-password <client-slug> $base" >&2
    echo "" >&2
    echo "  For your own internal page, opt in explicitly:" >&2
    echo "    echo '$base MASTER' >> $KEYMAP" >&2
    exit 1
  fi

  case "$var" in
    MASTER) ;;
    CLIENT_*_PW)
      if [ -z "${!var:-}" ]; then
        echo "COMMIT BLOCKED - '$base' maps to $var, but $var is not set in .env." >&2
        echo "  Not falling back to the master password." >&2
        exit 1
      fi ;;
    *)
      if [ -z "${ENCRYPT_SECRET:-}" ]; then
        echo "COMMIT BLOCKED - '$base' maps to client '$var', whose passphrase is" >&2
        echo "  derived, but ENCRYPT_SECRET is not set in .env." >&2
        echo "  Without it the passphrase cannot be reproduced. Restore .env." >&2
        exit 1
      fi ;;
  esac

  if ! page_pw="$(resolve_password "$var")" || [ -z "$page_pw" ]; then
    echo "COMMIT BLOCKED - could not resolve a password for '$base' (key: $var)." >&2
    exit 1
  fi

  # StatiCrypt uses a random IV, so identical input yields different output on
  # every run. Re-encrypting unchanged pages would rewrite every file on every
  # commit, so only re-encrypt when the plaintext, its mapping, or the resolved
  # password changed. Folding the password in means rotating ENCRYPT_SECRET
  # re-encrypts every affected page instead of silently leaving them on the old
  # one. The manifest stores a salted hash, so it reveals nothing.
  hash="$( { printf '%s%s%s' "$STATICRYPT_SALT" "$var" "$page_pw"; cat "$src"; } \
           | shasum -a 256 | awk '{print $1}' )"
  prev="$(awk -v b="$base" '$1==b {print $2}' "$MANIFEST")"
  if [ "$hash" = "$prev" ] && [ -f "$OUT/$base" ]; then
    continue
  fi

  todo_src+=("$src"); todo_base+=("$base"); todo_var+=("$var"); todo_hash+=("$hash"); todo_pw+=("$page_pw")
done

# ---------------------------------------------------------------- pass 2
count=0
for i in "${!todo_src[@]}"; do
  base="${todo_base[$i]}"; var="${todo_var[$i]}"

  page_pw="${todo_pw[$i]}"

  # Password goes via the environment, never argv - argv is visible in ps.
  # dotenv does not overwrite an already-set variable, so this wins over .env.
  STATICRYPT_PASSWORD="$page_pw" \
    npx --no-install staticrypt "${todo_src[$i]}" -d "$OUT" --remember false --short >/dev/null

  awk -v b="$base" '$1!=b' "$MANIFEST" > "$MANIFEST.tmp"
  mv "$MANIFEST.tmp" "$MANIFEST"
  printf '%s %s\n' "$base" "${todo_hash[$i]}" >> "$MANIFEST"

  git add "$OUT/$base"
  echo "  encrypted: $base  (key: $var)"
  count=$((count+1))
done

if [ "$count" -gt 0 ]; then
  git add "$MANIFEST"
  echo "pre-commit: encrypted $count page(s) into $OUT/"
fi
exit 0
