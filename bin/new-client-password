#!/usr/bin/env bash
# Map a page to a client. The passphrase is DERIVED from the master secret, so
# there is nothing to generate and nothing to store - this only records which
# client a page belongs to.
#
#   bin/new-client-password <client-slug> [page.html]
#
# Read the passphrase back when you are ready to send it:
#   bin/client-password <client-slug>
#
set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

KEYMAP=".page-keys"
slug="${1:-}"
page="${2:-}"

if [ -z "$slug" ]; then
  echo "usage: bin/new-client-password <client-slug> [page.html]" >&2
  exit 2
fi
if ! printf '%s' "$slug" | grep -qE '^[a-z0-9][a-z0-9-]*$'; then
  echo "ERROR: slug must be lowercase letters, digits and hyphens (e.g. acme-corp)" >&2
  exit 2
fi
[ -f .env ] || { echo "ERROR: .env not found in $ROOT" >&2; exit 1; }
set -a; . ./.env; set +a
: "${ENCRYPT_SECRET:?ENCRYPT_SECRET missing from .env - generate it first (see CLAUDE.md)}"

# Prove the passphrase can actually be derived before mapping anything to it.
if ! ENCRYPT_SECRET="$ENCRYPT_SECRET" python3 bin/derive_passphrase.py "$slug" >/dev/null; then
  echo "ERROR: could not derive a passphrase for '$slug' - not mapping the page." >&2
  exit 1
fi
echo "Passphrase for '$slug' derives cleanly (value not printed)."

if [ -n "$page" ]; then
  touch "$KEYMAP"
  existing="$(awk -v f="$page" '$1==f {print $2; exit}' "$KEYMAP")"
  if [ -n "$existing" ]; then
    if [ "$existing" = "$slug" ]; then
      echo "NOTE: $KEYMAP already maps $page -> $slug. Nothing to do."
    else
      echo "ERROR: $KEYMAP already maps $page -> $existing, not $slug." >&2
      echo "  Repointing a published page changes its password. Edit by hand" >&2
      echo "  if that is genuinely what you want - and remember the old" >&2
      echo "  ciphertext stays in git history under the old password." >&2
      exit 1
    fi
  else
    printf '%s %s\n' "$page" "$slug" >> "$KEYMAP"
    echo "Mapped $page -> $slug in $KEYMAP"
  fi
else
  echo "Next: map a page to it, e.g."
  echo "  echo 'report-2026-q3.html $slug' >> $KEYMAP"
fi

echo
echo "To send it:  bin/client-password $slug"
