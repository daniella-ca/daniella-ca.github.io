#!/usr/bin/env bash
# Generate a per-client passphrase and append it to .env.
# The value is never printed - read it back deliberately when you send it.
#
#   bin/new-client-password <client-slug> [page.html]
#
set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

WORDS=/usr/share/dict/words
KEYMAP=".page-keys"
NWORDS=5

slug="${1:-}"
page="${2:-}"

if [ -z "$slug" ]; then
  echo "usage: bin/new-client-password <client-slug> [page.html]" >&2
  exit 2
fi
if ! printf '%s' "$slug" | grep -qE '^[a-z0-9][a-z0-9-]*$'; then
  echo "ERROR: slug must be lowercase letters, digits and hyphens (e.g. acme-corp)" >&2
  exit 2
fi
[ -f .env ]   || { echo "ERROR: .env not found in $ROOT" >&2; exit 1; }
[ -f "$WORDS" ] || { echo "ERROR: wordlist $WORDS not found" >&2; exit 1; }

var="CLIENT_$(printf '%s' "$slug" | tr 'a-z-' 'A-Z_')_PW"

if grep -q "^${var}=" .env; then
  echo "ERROR: $var already exists in .env - refusing to overwrite." >&2
  echo "Rotating a password does not protect anything already published:" >&2
  echo "the old ciphertext stays in git history and remains crackable." >&2
  echo "Delete the line by hand if you are certain." >&2
  exit 1
fi

# Passphrase: NWORDS words drawn from the wordlist with a CSPRNG.
pool_file="$(mktemp)"
trap 'rm -f "$pool_file"' EXIT
grep '^[a-z]\{4,8\}$' "$WORDS" > "$pool_file"
pool_size="$(wc -l < "$pool_file" | tr -d ' ')"

phrase=""
for _ in $(seq "$NWORDS"); do
  idx=$(( ( $(od -An -N4 -tu4 < /dev/urandom | tr -d ' ') % pool_size ) + 1 ))
  word="$(sed -n "${idx}p" "$pool_file")"
  phrase="${phrase:+$phrase-}$word"
done

umask 077
printf '%s=%s\n' "$var" "$phrase" >> .env
chmod 600 .env
unset phrase

echo "Added $var to .env ($NWORDS random words, value not printed)."

if [ -n "$page" ]; then
  touch "$KEYMAP"
  if awk -v f="$page" '$1==f {found=1} END{exit !found}' "$KEYMAP"; then
    echo "NOTE: $KEYMAP already maps $page - left unchanged."
  else
    printf '%s %s\n' "$page" "$var" >> "$KEYMAP"
    echo "Mapped $page -> $var in $KEYMAP"
  fi
else
  echo "Next: map the page to it, e.g."
  echo "  echo 'report-2026-q3.html $var' >> $KEYMAP"
fi

echo
echo "To send it to the client, read it back deliberately:"
echo "  grep '^${var}=' .env | cut -d= -f2-"
echo "Send the link and the password through different channels."
