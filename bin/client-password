#!/usr/bin/env bash
# Print one client's passphrase, so you can send it. Deliberate by design -
# nothing else in this repo ever prints it.
#
#   bin/client-password <client-slug>
#
set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

slug="${1:-}"
if [ -z "$slug" ]; then
  echo "usage: bin/client-password <client-slug>" >&2
  exit 2
fi

[ -f .env ] || { echo "ERROR: .env not found in $ROOT" >&2; exit 1; }
set -a; . ./.env; set +a

# Legacy: a password stored in .env before the derived scheme. Still honoured
# so pages encrypted under the old scheme keep working.
legacy="CLIENT_$(printf '%s' "$slug" | tr 'a-z-' 'A-Z_')_PW"
if [ -n "${!legacy:-}" ]; then
  echo "$slug uses a stored password ($legacy, pre-derivation):"
  printf '%s\n' "${!legacy}"
  exit 0
fi

: "${ENCRYPT_SECRET:?ENCRYPT_SECRET missing from .env - cannot derive}"
ENCRYPT_SECRET="$ENCRYPT_SECRET" python3 bin/derive_passphrase.py "$slug"

echo
echo "Send the link and the password through different channels." >&2
